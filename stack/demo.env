# Local-only defaults for services bound to 127.0.0.1. A real deployment sets its own values;
# EKOS stores only the NAMES of these variables, never their values.
# Paths (where the seed, the checkouts and the EKOS home live) are not here: stack/paths.sh decides
# them, with portable defaults and an optional git-ignored stack/local.env.

EKOS_SOURCE_ADMIN_PASSWORD=source-admin-local-only
EKOS_SOURCE_PASSWORD=ekos-ro-local-only
EKOS_LH_S3_KEY=lakehouse
EKOS_LH_S3_SECRET=lakehouse-local-only
EKOS_LH_POLARIS_SECRET=polaris-local-only
EKOS_LH_PII_KEY=demo-only-pii-key
SUPERSET_SECRET_KEY=superset-demo-local-only-secret
EKOS_MCP_TOKEN=mcp-demo-local-only-token

# Ask (AI): Claude Haiku 5.5 through OpenCode Zen (stack/docker-compose.yml; override with
# EKOS_AI_MODEL_ZEN). It needs OPENCODE_API_KEY in the shell that runs `make bi`; only the variable's
# name is passed on, never written to a file. EKOS_AI_MODEL below was the earlier local Ollama model.
EKOS_AI_MODEL=qwen2.5-coder:3b

# Step 9: the demo analyst in Superset (scripts/superset-init.sh); dashboards health signs in as her.
DEMO_SUPERSET_PASSWORD=maria-local-only

# RFC 0260: a mart edit on the host plans and checks the mart in DuckDB, attached to the Iceberg catalog
# the way the generated profiles.yml attaches it. These are the variables it names (the same values the
# Dagster container gets from docker-compose.yml); the S3 endpoint is the host's port for SeaweedFS.
AWS_ACCESS_KEY_ID=${EKOS_LH_S3_KEY}
AWS_SECRET_ACCESS_KEY=${EKOS_LH_S3_SECRET}
EKOS_LH_POLARIS_CLIENT_ID=root
EKOS_LH_POLARIS_CLIENT_SECRET=${EKOS_LH_POLARIS_SECRET}
