# Copy to stack/local.env (git-ignored) and keep only the lines you change. Read by stack/paths.sh,
# which gives every variable below a default; see that file for what each one is.

# A large disk for the seed, the venv, the checkouts and the snapshots (several GB):
#EKOS_DEMO_DATA=/data/ekos-duckdemo

# The fastest disk for the EKOS home (about 1 GB, written heavily during an analysis):
#EKOS_DEMO_STATE=/nvme/ekos-duckdemo

# Checkouts you already have:
#IDEMPIERE_SRC=$HOME/src/idempiere
#IDEMPIERE_DOCS=$HOME/src/idempiere.github.io
#EKOS_LAKEHOUSE_SRC=$HOME/src/ekos-lakehouse
#SUPERSET_SRC=$HOME/src/ekos-superset

# A binary that is not on PATH:
#EKOS_LAKEHOUSE_BIN=$HOME/src/ekos-lakehouse/target/release/ekos-lakehouse
